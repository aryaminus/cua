# cua — environment configuration. Copy to `.env` (gitignored) and fill in.

# --- Optional: site deploy (see .github/workflows/deploy-site.yml) -----------
# NETLIFY_AUTH_TOKEN=...   # only for deploying site/; never needed for tests

# --- Required for discovery runs (LLM-driven). Replays need no key. ----------
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Generative model used by the discovery loop (temperature 0, JSON mode).
# deepseek-v4.1-flash: cheap, JSON-capable, positioned for computer-use agents.
CUA_MODEL=deepseek/deepseek-v4.1-flash

# Decision model (TypeSafe Jev via OpenRouter's /api/alpha/decisions) used for
# stuck/no-progress detection during discovery. Optional: if unset or the call
# fails, discovery falls back to deterministic no-progress rules only.
CUA_JEV_MODEL=typesafe/jev-1.13

# --- Target application -------------------------------------------------------
# The bundled mock credit-union console (cua serve). Fixed port for determinism.
CUA_APP_URL=http://127.0.0.1:8791

# --- Safety --------------------------------------------------------------------
# Allowlist file: permitted origins, routes, and action types. Enforced on every
# action in BOTH discovery and replay.
CUA_ALLOWLIST=config/allowlist.json

# --- Privacy posture (optional; see REPORT.md §Safety) --------------------------
# CUA_DATA_COLLECTION=deny    # route model calls only to zero-retention endpoints
#
# --- Fault injection for the mock app (evidence runs arm these deliberately) ---
# MOCKAPP_FAULT=server_error_member_1003   # /member/1003 returns HTTP 500
# MOCKAPP_SESSION_TTL=3                    # session expires after 3 page loads
# MOCKAPP_SLOW_MEMBER=1006                   # that member page sleeps briefly
# MOCKAPP_SLOW_SECONDS=2.5                   # how long the slow page sleeps
# MOCKAPP_BUSY_MEMBER=1002                   # first request renders one System Busy page
